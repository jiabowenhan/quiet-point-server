{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".runtime-addons",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "addons/**/*.ts",
    "addons/**/*.js",
    "shared/**/*.ts",
    "server/insights.ts"
  ]
}
